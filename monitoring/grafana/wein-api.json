{"uid": "wein-api", "title": "Wein-API", "tags": ["wein-mlops"], "timezone": "browser", "schemaVersion": 41, "version": 1, "refresh": "5s", "time": {"from": "now-15m", "to": "now"}, "panels": [
  {"id": 1, "type": "stat", "title": "API erreichbar", "description": "1 = Prometheus erreicht die API, 0 = nicht erreichbar", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "up{job=\"wein-api\"}", "legendFormat": "up"}], "fieldConfig": {"defaults": {}, "overrides": []}, "options": {}},
  {"id": 2, "type": "stat", "title": "Anfragen pro Sekunde", "description": "", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(wein_http_anfragen_total{pfad!~\"/metrics|/health\"}[1m]))", "legendFormat": "gesamt"}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "options": {}},
  {"id": 3, "type": "stat", "title": "Fehlerquote (4xx und 5xx)", "description": "", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(wein_http_anfragen_total{status=~\"4..|5..\"}[1m])) / sum(rate(wein_http_anfragen_total{pfad!~\"/metrics|/health\"}[1m]))", "legendFormat": "Fehler"}], "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}, "options": {}},
  {"id": 4, "type": "stat", "title": "LLM-Fallbacks (letzte 5 Minuten)", "description": "", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(increase(wein_llm_anfragen_total{ergebnis=\"fallback\"}[5m]))", "legendFormat": "Fallbacks"}], "fieldConfig": {"defaults": {}, "overrides": []}, "options": {}},
  {"id": 5, "type": "timeseries", "title": "Verkehr: Anfragen pro Sekunde nach Pfad und Status", "description": "", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (pfad, status) (rate(wein_http_anfragen_total{pfad!~\"/metrics|/health\"}[1m]))", "legendFormat": "{{pfad}} {{status}}"}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "options": {}},
  {"id": 6, "type": "timeseries", "title": "Latenz /vorhersage (p50, p95)", "description": "", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.5, sum by (le) (rate(wein_http_latenz_sekunden_bucket{pfad=\"/vorhersage\"}[1m])))", "legendFormat": "p50"}, {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum by (le) (rate(wein_http_latenz_sekunden_bucket{pfad=\"/vorhersage\"}[1m])))", "legendFormat": "p95"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "options": {}},
  {"id": 7, "type": "timeseries", "title": "Vorhersagen pro Sorte (pro Sekunde)", "description": "Ändert sich die Verteilung stark, haben sich vielleicht die Daten geändert (Drift).", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (sorte) (rate(wein_vorhersagen_total[1m]))", "legendFormat": "{{sorte}}"}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "options": {}},
  {"id": 8, "type": "timeseries", "title": "Sicherheit des Modells (Median)", "description": "Sinkt die Sicherheit, sieht das Modell ungewohnte Daten.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.5, sum by (le) (rate(wein_vorhersage_sicherheit_bucket[1m])))", "legendFormat": "Median"}], "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}, "options": {}},
  {"id": 9, "type": "timeseries", "title": "LLM: Anfragen nach Ergebnis (pro Minute)", "description": "", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 20, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (ergebnis) (rate(wein_llm_anfragen_total[1m])) * 60", "legendFormat": "{{ergebnis}}"}], "fieldConfig": {"defaults": {}, "overrides": []}, "options": {}},
  {"id": 10, "type": "timeseries", "title": "LLM: Latenz p95", "description": "", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 8, "y": 20, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum by (le) (rate(wein_llm_latenz_sekunden_bucket[5m])))", "legendFormat": "p95"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "options": {}},
  {"id": 11, "type": "timeseries", "title": "LLM: Tokens pro Minute", "description": "", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 16, "y": 20, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(wein_llm_tokens_total[1m])) * 60", "legendFormat": "Tokens"}], "fieldConfig": {"defaults": {}, "overrides": []}, "options": {}}
]}