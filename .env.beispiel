# Datei: .env.beispiel – in VS Code einfügen und speichern
# Vorlage für die Datei .env (ab Tag 18). Kopieren:  cp .env.beispiel .env
# Die Datei .env steht in .gitignore und .dockerignore. Sie kommt nie in Git und nie ins Image.
# Docker Compose liest .env automatisch beim Start.

# Standard: Ollama im Compose-Stack, ohne Key.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODELL=llama3.2:3b
LLM_API_KEY=ollama

# Ausweichweg: Groq in der Cloud (eigenes Konto, eigener Key).
# Dann die drei Zeilen oben mit # abschalten und diese drei Zeilen einschalten:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODELL=llama-3.1-8b-instant
# LLM_API_KEY=DEIN_GROQ_KEY